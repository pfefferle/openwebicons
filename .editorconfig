# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with trim trailing whitespaces
[*]
end_of_line = lf
trim_trailing_whitespace = true

# 2 space indentation
indent_style = space
indent_size = 2

# charset
charset = utf-8

# WordPress coding standards
[*.php]
indent_style = tab
